{
  "name": "obsidian-game-shelf",
  "version": "1.0.1",
  "description": "Create game notes and manage your playing, backlog, and memories in a local Markdown library.",
  "private": true,
  "license": "MIT",
  "author": "tetsuya-dev-jp",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "jsdom": "^31.0.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "type": "module"
}
